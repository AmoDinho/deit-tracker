# Copy to .env. Local dev works with every value below left blank:
# embedded Postgres in .data/pglite, photos in .data/uploads, keyword AI fallback.

PORT=8787
DATABASE_URL=
PGLITE_DATA=
UPLOAD_DIR=

# Auth. Keep BETTER_AUTH_URL on the web origin so the session cookie is first-party.
BETTER_AUTH_SECRET=deit-dev-secret-change-in-production-32
BETTER_AUTH_URL=http://localhost:5173
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:5173
CORS_ORIGINS=http://localhost:5173

# Demo account demo@deit.app / demopass. Set false in production.
SEED_DEMO=true
DAILY_AI_LIMIT=40

# Optional Google sign-in. Leave blank to hide the button.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional vision/text model. OpenAI-compatible. Default provider is DeepSeek.
AI_BASE_URL=https://api.deepseek.com
AI_API_KEY=
AI_VISION_MODEL=deepseek-flash
AI_TEXT_MODEL=deepseek-flash

# Optional USDA FoodData Central key. Seeded foods still search without it.
FDC_API_KEY=

# Optional private S3 bucket. Without these, uploads stay on local disk.
AWS_REGION=af-south-1
AWS_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Web only, when the API is on another origin. Leave empty for the Vite proxy.
# VITE_API_URL=https://api.example.com
